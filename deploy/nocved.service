# nocved: continuous host behaviour sensor (push-only; opens no port).
# Root is required to read other users' /proc/<pid>/{exe,cwd,fd}, root-only
# logs and authorized_keys; the capability bounding set limits root to
# CAP_DAC_READ_SEARCH (read any file/dir) and CAP_SYS_PTRACE (ptrace-mode read
# checks on /proc/<pid>/exe|cwd|fd). nocved never opens /proc/<pid>/mem or environ.
[Unit]
Description=nocved host behaviour sensor
Documentation=file:///usr/local/share/doc/nocved/DESIGN.md
After=network-online.target
Wants=network-online.target

[Service]
# notify + watchdog: nocved sends READY=1 once started and WATCHDOG=1 from the
# main poll loop (not the shipper thread). A poll loop stuck for 60 s (FIFO,
# hung read) is killed and restarted even though heartbeats would continue;
# the store also raises sensor.stalled from the heartbeat's last_tick_ms.
Type=notify
NotifyAccess=main
WatchdogSec=60
ExecStart=/usr/local/bin/nocved run --config /etc/nocved/config.json
Restart=always
RestartSec=5
User=root
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nocved
# Optional cveguard feed (config "feed": {"enabled": true, "group": "cveguard"}):
# nocved has no CAP_CHOWN, so it must be a member of the feed group to set it.
#SupplementaryGroups=cveguard
StateDirectory=nocved
StateDirectoryMode=0700
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=default
ProcSubset=all
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @raw-io @module @obsolete
UMask=0077
MemoryMax=128M
CPUQuota=5%
Nice=10
# best-effort/7, not idle: the idle class can starve the sensor indefinitely
# under sustained I/O (an attacker can generate that load on purpose).
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
